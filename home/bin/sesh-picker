#!/usr/bin/env bash
# sesh session picker

set -euo pipefail

picker() {
    sesh connect "$(
        sesh list --icons "$@" \
            | gum filter --limit 1 --header "sesh session picker" --placeholder "session" --prompt ' '
    )"
}

# if we're run from inside of tmux, run in oneshot mode (either switching
# manually or inside a display-popup).
if [[ -n ${TMUX:-} ]]; then
    picker "$@"
    exit $?
fi

# Outside tmux, use the native window chooser after a session ends.
# Fall back to sesh when there are no tmux sessions left.
while :; do
    picker "$@"
    while tmux has-session 2>/dev/null; do
        tmux attach-session \; choose-window || break
    done
done
